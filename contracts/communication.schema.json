{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommunicationContracts",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "settingsSavePayload": { "$ref": "#/definitions/SettingsSavePayload" },
    "asyncCommand": { "$ref": "#/definitions/AsyncCommand" },
    "asyncProgressPayload": { "$ref": "#/definitions/AsyncProgressPayload" },
    "asyncDonePayload": { "$ref": "#/definitions/AsyncDonePayload" },
    "frontendLogPayload": { "$ref": "#/definitions/FrontendLogPayload" },
    "saveErrorPayload": { "$ref": "#/definitions/SaveErrorPayload" },
    "healthReport": { "$ref": "#/definitions/HealthReport" },
    "runtimeStatus": { "$ref": "#/definitions/RuntimeStatus" },
    "initialState": { "$ref": "#/definitions/InitialState" },
    "prosodyPayload": { "$ref": "#/definitions/ProsodyPayload" },
    "showLogFileResult": { "$ref": "#/definitions/ShowLogFileResult" },
    "supportReportResult": { "$ref": "#/definitions/SupportReportResult" },
    "batchInitialState": { "$ref": "#/definitions/BatchInitialState" },
    "batchStartRequest": { "$ref": "#/definitions/BatchStartRequest" },
    "batchProgressPayload": { "$ref": "#/definitions/BatchProgressPayload" },
    "batchLogPayload": { "$ref": "#/definitions/BatchLogPayload" },
    "batchFinishPayload": { "$ref": "#/definitions/BatchFinishPayload" },
    "batchErrorPayload": { "$ref": "#/definitions/BatchErrorPayload" },
    "audioExportInitialState": { "$ref": "#/definitions/AudioExportInitialState" },
    "audioExportStartRequest": { "$ref": "#/definitions/AudioExportStartRequest" },
    "audioExportDestinationRequest": { "$ref": "#/definitions/AudioExportDestinationRequest" },
    "audioExportDestinationPayload": { "$ref": "#/definitions/AudioExportDestinationPayload" },
    "audioExportProgressPayload": { "$ref": "#/definitions/AudioExportProgressPayload" },
    "audioExportFinishPayload": { "$ref": "#/definitions/AudioExportFinishPayload" },
    "audioExportErrorPayload": { "$ref": "#/definitions/BatchErrorPayload" },
    "pendingEditorIntent": { "$ref": "#/definitions/PendingEditorIntent" },
    "editorIntentReceipt": { "$ref": "#/definitions/EditorIntentReceipt" },
    "recorderCommand": { "$ref": "#/definitions/RecorderCommand" },
    "recorderSnapshot": { "$ref": "#/definitions/RecorderSnapshot" },
    "sourceMutationCommand": { "$ref": "#/definitions/SourceMutationCommand" }
  },
  "definitions": {
    "Config": {
      "$comment": "Replaced by scripts/generate_contracts.py from addon/anki_audio_quick_editor/config.schema.json before quicktype runs.",
      "type": "object"
    },
    "JsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": {}
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "EditorLifecycleTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editorSessionId",
        "noteId",
        "fieldOrd",
        "backendMediaGeneration",
        "sourceFilename"
      ],
      "properties": {
        "editorSessionId": { "type": "integer", "minimum": 1 },
        "noteId": { "type": ["integer", "null"] },
        "fieldOrd": { "type": "integer", "minimum": 0 },
        "backendMediaGeneration": { "type": "integer", "minimum": 0 },
        "sourceFilename": { "type": "string", "minLength": 1 }
      }
    },
    "PendingEditorAutoplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requireGraphRedraw", "expectedDurationMs", "repeatPauseMs"],
      "properties": {
        "kind": { "enum": ["once", "repeat"] },
        "requireGraphRedraw": { "type": "boolean" },
        "expectedDurationMs": { "type": ["integer", "null"], "minimum": 1 },
        "repeatPauseMs": { "type": "integer", "minimum": 0 }
      }
    },
    "PendingEditorIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "deliveryId",
        "expiresAtEpochMs",
        "target",
        "sourceKind",
        "autoplay"
      ],
      "properties": {
        "schemaVersion": { "enum": [1] },
        "deliveryId": { "type": "string", "minLength": 1 },
        "expiresAtEpochMs": { "type": "integer", "minimum": 1 },
        "target": { "$ref": "#/definitions/EditorLifecycleTarget" },
        "sourceKind": { "enum": ["generated_edit", "existing_media"] },
        "autoplay": { "$ref": "#/definitions/PendingEditorAutoplay" }
      }
    },
    "EditorIntentReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "deliveryId", "editorSessionId", "outcome"],
      "properties": {
        "schemaVersion": { "enum": [1] },
        "deliveryId": { "type": "string", "minLength": 1 },
        "editorSessionId": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["applied", "autoplay_accepted", "failed", "cancelled"] }
      }
    },
    "RecorderStartCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "fieldOrd", "startCursorMs", "graphSettings"],
      "properties": {
        "schemaVersion": { "enum": [1] },
        "kind": { "enum": ["start"] },
        "fieldOrd": { "type": "integer", "minimum": 0 },
        "startCursorMs": { "type": "integer", "minimum": 0 },
        "graphSettings": { "type": "object", "additionalProperties": true }
      }
    },
    "RecorderStopCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "fieldOrd"],
      "properties": {
        "schemaVersion": { "enum": [1] },
        "kind": { "enum": ["stop"] },
        "fieldOrd": { "type": "integer", "minimum": 0 }
      }
    },
    "RecorderCancelCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "fieldOrd", "reason"],
      "properties": {
        "schemaVersion": { "enum": [1] },
        "kind": { "enum": ["cancel"] },
        "fieldOrd": { "type": "integer", "minimum": 0 },
        "reason": { "enum": ["user", "source_replaced", "note_changed"] }
      }
    },
    "RecorderCommand": {
      "oneOf": [
        { "$ref": "#/definitions/RecorderStartCommand" },
        { "$ref": "#/definitions/RecorderStopCommand" },
        { "$ref": "#/definitions/RecorderCancelCommand" }
      ]
    },
    "RecorderSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "fieldOrd",
        "attemptId",
        "targetDurationMs",
        "startCursorMs",
        "mediaFilename",
        "recordingDurationMs",
        "failureMessage"
      ],
      "properties": {
        "schemaVersion": { "enum": [1] },
        "status": { "enum": ["idle", "countdown", "starting", "recording", "stopping", "finalizing", "analyzing", "ready", "failed"] },
        "fieldOrd": { "type": ["integer", "null"], "minimum": 0 },
        "attemptId": { "type": ["integer", "null"], "minimum": 1 },
        "targetDurationMs": { "type": ["integer", "null"], "minimum": 0 },
        "startCursorMs": { "type": "integer", "minimum": 0 },
        "mediaFilename": { "type": ["string", "null"] },
        "recordingDurationMs": { "type": ["integer", "null"], "minimum": 0 },
        "failureMessage": { "type": ["string", "null"] }
      }
    },
    "FrontendFailureContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeId", "fieldInstanceId", "sourceInstanceId", "attemptId", "failureId"],
      "properties": {
        "runtimeId": { "type": "string", "minLength": 1 },
        "fieldInstanceId": { "type": "string", "minLength": 1 },
        "sourceInstanceId": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "failureId": { "type": "string", "minLength": 1 }
      }
    },
    "SourceMutationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "target", "failure"],
      "properties": {
        "schemaVersion": { "enum": [1] },
        "kind": { "enum": ["convert_to_mp3"] },
        "target": { "$ref": "#/definitions/EditorLifecycleTarget" },
        "failure": { "$ref": "#/definitions/FrontendFailureContext" }
      }
    },
    "SettingsSavePayload": {
      "$ref": "#/definitions/Config"
    },
    "DiagnosticsState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["addon_id", "collection_available", "release_info", "runtime"],
      "properties": {
        "addon_id": { "type": "string" },
        "collection_available": { "type": "boolean" },
        "release_info": { "$ref": "#/definitions/ReleaseInfo" },
        "runtime": { "$ref": "#/definitions/RuntimeStatus" }
      }
    },
    "ReleaseInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_hash", "commit_message"],
      "properties": {
        "commit_hash": { "type": "string" },
        "commit_message": { "type": "string" }
      }
    },
    "InitialState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "version",
        "addon_dir",
        "log_file_path",
        "locale",
        "direction",
        "messages",
        "diagnostics",
        "triggers"
      ],
      "properties": {
        "config": { "$ref": "#/definitions/Config" },
        "version": { "type": "string" },
        "addon_dir": { "type": "string" },
        "log_file_path": { "type": "string" },
        "locale": { "type": "string" },
        "direction": { "enum": ["ltr", "rtl"] },
        "messages": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "diagnostics": { "$ref": "#/definitions/DiagnosticsState" },
        "triggers": { "$ref": "#/definitions/TriggerSettingsMetadata" }
      }
    },
    "TriggerNoteTypeOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "fields"],
      "properties": {
        "id": { "type": ["integer", "null"] },
        "name": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "TriggerSettingsMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note_types"],
      "properties": {
        "note_types": {
          "type": "array",
          "items": { "$ref": "#/definitions/TriggerNoteTypeOption" }
        }
      }
    },
    "HealthCheckPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config"],
      "properties": {
        "config": { "$ref": "#/definitions/Config" }
      }
    },
    "SupportReportPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config"],
      "properties": {
        "config": { "$ref": "#/definitions/Config" }
      }
    },
    "ShowLogFilePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "RuntimeStatusPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "RuntimeInstallPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "HealthCheckAsyncCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "payload"],
      "properties": {
        "id": { "type": "string" },
        "op": { "type": "string" },
        "payload": { "$ref": "#/definitions/HealthCheckPayload" }
      }
    },
    "SupportReportAsyncCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "payload"],
      "properties": {
        "id": { "type": "string" },
        "op": { "type": "string" },
        "payload": { "$ref": "#/definitions/SupportReportPayload" }
      }
    },
    "ShowLogFileAsyncCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "payload"],
      "properties": {
        "id": { "type": "string" },
        "op": { "type": "string" },
        "payload": { "$ref": "#/definitions/ShowLogFilePayload" }
      }
    },
    "RuntimeStatusAsyncCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "payload"],
      "properties": {
        "id": { "type": "string" },
        "op": { "type": "string" },
        "payload": { "$ref": "#/definitions/RuntimeStatusPayload" }
      }
    },
    "RuntimeInstallAsyncCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op", "payload"],
      "properties": {
        "id": { "type": "string" },
        "op": { "type": "string" },
        "payload": { "$ref": "#/definitions/RuntimeInstallPayload" }
      }
    },
    "AsyncCommand": {
      "oneOf": [
        { "$ref": "#/definitions/HealthCheckAsyncCommand" },
        { "$ref": "#/definitions/SupportReportAsyncCommand" },
        { "$ref": "#/definitions/ShowLogFileAsyncCommand" },
        { "$ref": "#/definitions/RuntimeStatusAsyncCommand" },
        { "$ref": "#/definitions/RuntimeInstallAsyncCommand" }
      ]
    },
    "AsyncProgressPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "progress", "message"],
      "properties": {
        "id": { "type": "string" },
        "progress": { "type": "integer" },
        "message": { "type": "string" }
      }
    },
    "ExternalToolHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "path", "source", "version", "error"],
      "properties": {
        "available": { "type": "boolean" },
        "path": { "type": "string" },
        "source": { "type": "string", "enum": ["", "config", "managed", "bundled", "PATH"] },
        "version": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "RuntimeStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "runtime_manifest_id", "platform", "runtime_root", "progress", "message", "error"],
      "properties": {
        "phase": { "enum": ["ready", "missing", "downloading", "error", "unsupported"] },
        "runtime_manifest_id": { "type": "string" },
        "platform": { "type": "string" },
        "runtime_root": { "type": "string" },
        "progress": { "type": "integer" },
        "message": { "type": "string" },
        "error": { "type": "string" }
      }
    },
    "HealthReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection_available", "deck_count", "note_type_count", "card_count"],
      "properties": {
        "collection_available": { "type": "boolean" },
        "deck_count": { "type": "integer" },
        "note_type_count": { "type": "integer" },
        "card_count": { "type": "integer" },
        "deep_filter": { "$ref": "#/definitions/ExternalToolHealth" },
        "rnnoise": { "$ref": "#/definitions/ExternalToolHealth" },
        "dpdfnet": { "$ref": "#/definitions/ExternalToolHealth" },
        "spleeter": { "$ref": "#/definitions/ExternalToolHealth" },
        "silero_vad": { "$ref": "#/definitions/ExternalToolHealth" },
        "runtime": { "$ref": "#/definitions/RuntimeStatus" }
      }
    },
    "SupportReportResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportFilePath"],
      "properties": {
        "reportFilePath": { "type": "string" }
      }
    },
    "ShowLogFileResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logFilePath"],
      "properties": {
        "logFilePath": { "type": "string" }
      }
    },
    "BatchOperationName": {
      "enum": ["graph", "convert", "reduce_size", "denoise", "remove_pauses", "slower", "faster", "volume_down", "volume_up", "preset"]
    },
    "BatchParameterKind": {
      "enum": ["none", "speed", "volume", "pause", "denoise", "format", "size_reduction", "preset"]
    },
    "BatchParameterName": {
      "enum": ["none", "speed_step", "volume_step_db", "pause_aggressiveness", "denoise_algorithm", "target_format", "size_reduction_mode", "preset_id"]
    },
    "BatchPauseAggressiveness": {
      "enum": ["gentle", "normal", "aggressive"]
    },
    "BatchPauseDetectionAlgorithm": {
      "enum": ["silencedetect", "silero_vad"]
    },
    "DenoiseAlgorithm": {
      "enum": ["standard", "rnnoise", "dpdfnet", "voice_only"]
    },
    "OutputFormat": {
      "enum": ["source", "mp3", "m4a", "wav", "flac"]
    },
    "SizeReductionMode": {
      "enum": ["gentle", "normal", "aggressive"]
    },
    "BatchSurface": {
      "enum": ["operations", "audio_export"]
    },
    "AudioExportMode": {
      "enum": ["zip", "combined_mp3"]
    },
    "AudioExportFieldSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notetype_name", "fields"],
      "properties": {
        "notetype_name": { "type": "string" },
        "fields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "AudioExportDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "silence_between_clips_seconds", "normalize_volume"],
      "properties": {
        "mode": { "$ref": "#/definitions/AudioExportMode" },
        "silence_between_clips_seconds": { "type": "number", "minimum": 0, "maximum": 10 },
        "normalize_volume": { "type": "boolean" }
      }
    },
    "BatchDpdfnetAttnLimitDB": {
      "enum": [6.0, 12.0, 18.0]
    },
    "BatchOperationParameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speed_step": { "type": "number" },
        "volume_step_db": { "type": "number" },
        "pause_aggressiveness": { "$ref": "#/definitions/BatchPauseAggressiveness" },
        "pause_detection_algorithm": { "$ref": "#/definitions/BatchPauseDetectionAlgorithm" },
        "pause_threshold": { "type": "number" },
        "pause_min_silence_seconds": { "type": "number" },
        "pause_min_speech_seconds": { "type": "number" },
        "pause_preprocess_denoise": { "type": "boolean" },
        "denoise_algorithm": { "$ref": "#/definitions/DenoiseAlgorithm" },
        "dpdfnet_attn_limit_db": { "$ref": "#/definitions/BatchDpdfnetAttnLimitDB" },
        "target_format": { "$ref": "#/definitions/OutputFormat" },
        "size_reduction_mode": { "$ref": "#/definitions/SizeReductionMode" },
        "size_reduction_bitrate_kbps": { "type": "integer", "minimum": 16, "maximum": 320 },
        "size_reduction_sample_rate_hz": {
          "type": "integer",
          "enum": [8000, 11025, 12000, 16000, 22050, 24000, 32000, 44100, 48000]
        },
        "size_reduction_channels": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "BatchOperationOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "label", "requires_target_field", "parameter_kind", "parameter_name"],
      "properties": {
        "operation": { "$ref": "#/definitions/BatchOperationName" },
        "label": { "type": "string" },
        "requires_target_field": { "type": "boolean" },
        "parameter_kind": { "$ref": "#/definitions/BatchParameterKind" },
        "parameter_name": { "$ref": "#/definitions/BatchParameterName" }
      }
    },
    "BatchFieldGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notetype_name", "fields"],
      "properties": {
        "notetype_name": { "type": "string" },
        "fields": { "type": "array", "items": { "type": "string" } }
      }
    },
    "BatchProcessingPresetOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "has_transforms", "graph_enabled"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "has_transforms": { "type": "boolean" },
        "graph_enabled": { "type": "boolean" }
      }
    },
    "BatchDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speed_step",
        "volume_step_db",
        "pause_aggressiveness",
        "pause_detection_algorithm",
        "pause_silencedetect_threshold_db",
        "pause_silencedetect_min_silence_seconds",
        "pause_silencedetect_min_speech_seconds",
        "pause_silencedetect_preprocess_denoise",
        "pause_silero_threshold",
        "pause_silero_min_silence_seconds",
        "pause_silero_min_speech_seconds",
        "pause_silero_preprocess_denoise",
        "denoise_algorithm",
        "dpdfnet_attn_limit_db",
        "output_format",
        "size_reduction_mode",
        "size_reduction_bitrate_kbps",
        "size_reduction_sample_rate_hz",
        "size_reduction_channels"
      ],
      "properties": {
        "speed_step": { "type": "number" },
        "volume_step_db": { "type": "number" },
        "pause_aggressiveness": { "$ref": "#/definitions/BatchPauseAggressiveness" },
        "pause_detection_algorithm": { "$ref": "#/definitions/BatchPauseDetectionAlgorithm" },
        "pause_silencedetect_threshold_db": { "type": "number" },
        "pause_silencedetect_min_silence_seconds": { "type": "number" },
        "pause_silencedetect_min_speech_seconds": { "type": "number" },
        "pause_silencedetect_preprocess_denoise": { "type": "boolean" },
        "pause_silero_threshold": { "type": "number" },
        "pause_silero_min_silence_seconds": { "type": "number" },
        "pause_silero_min_speech_seconds": { "type": "number" },
        "pause_silero_preprocess_denoise": { "type": "boolean" },
        "denoise_algorithm": { "$ref": "#/definitions/DenoiseAlgorithm" },
        "dpdfnet_attn_limit_db": { "$ref": "#/definitions/BatchDpdfnetAttnLimitDB" },
        "output_format": { "$ref": "#/definitions/OutputFormat" },
        "size_reduction_mode": { "$ref": "#/definitions/SizeReductionMode" },
        "size_reduction_bitrate_kbps": { "type": "integer", "minimum": 16, "maximum": 320 },
        "size_reduction_sample_rate_hz": {
          "type": "integer",
          "enum": [8000, 11025, 12000, 16000, 22050, 24000, 32000, 44100, 48000]
        },
        "size_reduction_channels": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "BatchInitialState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "note_count", "operations", "field_groups", "processing_presets", "defaults", "locale", "direction", "messages"],
      "properties": {
        "surface": { "$ref": "#/definitions/BatchSurface" },
        "note_count": { "type": "integer" },
        "operations": { "type": "array", "items": { "$ref": "#/definitions/BatchOperationOption" } },
        "field_groups": { "type": "array", "items": { "$ref": "#/definitions/BatchFieldGroup" } },
        "processing_presets": {
          "type": "array",
          "items": { "$ref": "#/definitions/BatchProcessingPresetOption" }
        },
        "defaults": { "$ref": "#/definitions/BatchDefaults" },
        "locale": { "type": "string" },
        "direction": { "enum": ["ltr", "rtl"] },
        "messages": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "AudioExportInitialState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "note_count",
        "field_groups",
        "default_field_selections",
        "defaults",
        "locale",
        "direction",
        "messages"
      ],
      "properties": {
        "surface": { "$ref": "#/definitions/BatchSurface" },
        "note_count": { "type": "integer" },
        "field_groups": { "type": "array", "items": { "$ref": "#/definitions/BatchFieldGroup" } },
        "default_field_selections": {
          "type": "array",
          "items": { "$ref": "#/definitions/AudioExportFieldSelection" }
        },
        "defaults": { "$ref": "#/definitions/AudioExportDefaults" },
        "locale": { "type": "string" },
        "direction": { "enum": ["ltr", "rtl"] },
        "messages": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
